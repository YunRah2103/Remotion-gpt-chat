    "worldkit:export": "node --experimental-strip-types scripts/world-kit/export-models.mjs",
    "worldkit:review": "node --experimental-strip-types scripts/world-kit/render-review.mjs",
    "worldkit:environments": "node --experimental-strip-types scripts/world-kit/render-environments.mjs",
    "worldkit:export-props": "node --experimental-strip-types scripts/world-kit/export-props.mjs",
    "worldkit:review-v3": "node --experimental-strip-types scripts/world-kit/render-v3.mjs",
    "partskit:studio": "remotion studio src/yunex/parts-kit/entry.tsx",
    "partskit:test": "node --experimental-strip-types --test tests/parts-kit/*.test.mjs",
    "partskit:export": "node --experimental-strip-types scripts/parts-kit/export.mjs",
    "partskit:review": "node --experimental-strip-types scripts/parts-kit/review.mjs",
    "worldkit:review-quality": "node --experimental-strip-types scripts/world-kit/render-quality.mjs",
    "worldkit:review-worlds": "node --experimental-strip-types scripts/world-kit/render-world-quality.mjs",
    "kit:catalog": "node --experimental-strip-types scripts/modelling-kit/studio.mjs catalog",
    "kit:create": "node --experimental-strip-types scripts/modelling-kit/studio.mjs create",
    "kit:validate": "node --experimental-strip-types scripts/modelling-kit/studio.mjs validate",
    "kit:render": "node --experimental-strip-types scripts/modelling-kit/studio.mjs render",
    "kit:preview": "node --experimental-strip-types scripts/modelling-kit/studio.mjs preview"
  },
  "dependencies": {
    "@remotion/captions": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/three": "4.0.533",
    "remotion": "4.0.533",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@react-three/fiber": "9.3.0",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "typescript": "5.9.3"
