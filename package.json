{
  "name": "remotion-gpt-chat",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts GpuDriveFilm out/GPU-DRIVE-001.mp4 --gl=swangle --codec=h264 --pixel-format=yuv420p",
    "worldkit:studio": "remotion studio src/yunex/world-kit/entry.tsx",
    "worldkit:test": "node --experimental-strip-types --test tests/world-kit/*.test.mjs",
    "worldkit:export": "node --experimental-strip-types scripts/world-kit/export-models.mjs",
    "worldkit:review": "node --experimental-strip-types scripts/world-kit/render-review.mjs"
  },
  "dependencies": {
    "@remotion/captions": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/three": "4.0.533",
    "remotion": "4.0.533",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@react-three/fiber": "9.3.0",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "typescript": "5.9.3"
  }
}
