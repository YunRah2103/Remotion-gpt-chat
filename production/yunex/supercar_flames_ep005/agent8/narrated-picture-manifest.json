  "captions": [
    {
      "start": 0,
      "end": 80,
      "text": "Why does this supercar\nsuddenly shoot fire?",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 96,
      "end": 126,
      "text": "It's not a flamethrower.",
