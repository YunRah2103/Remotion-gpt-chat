    },
    {
      "start": 138,
      "end": 189,
      "text": "Something even crazier\nis happening.",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 212,
      "end": 249,
      "text": "In some performance cars,",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 260,
      "end": 313,
      "text": "a little fuel can escape\nthe engine",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 322,
      "end": 352,
      "text": "without fully burning.",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 374,
      "end": 462,
      "text": "When it mixes with oxygen\ninside the scorching hot exhaust,",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 474,
      "end": 492,
      "text": "it can ignite.",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 517,
      "end": 574,
      "text": "That sudden combustion\nsends flames",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 580,
      "end": 616,
      "text": "shooting out of the tailpipe.",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 635,
      "end": 668,
      "text": "It's called afterfire.",
      "verified": true,
      "timingBasis": "owner_original_audio_phrase_boundaries_verified_by_listening_and_silence_detection"
    },
    {
      "start": 683,
      "end": 700,
